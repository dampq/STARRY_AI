# Copy to .env at repository root. Never commit real credentials.
PORT=3001
APP_ORIGIN=http://localhost:5173
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Select gemini or openai. Only the selected provider needs a key.
AI_PROVIDER=gemini
# Combines planning + writing, keeps independent review, and paces Gemini requests.
AI_GENERATION_MODE=free_tier
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional alternative provider:
STARRY_OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Set these to the SAME public Supabase project values as above.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# AI admission limits (per user / process; DB locking works across instances)
GENERATION_LIMIT_PER_HOUR=30
